#!/usr/bin/env bash
#===============================================================================
# GitLab CI Library - 环境配置文件示例
#
# 设计理念:
#   不同环境使用不同的配置文件，无需变量后缀机制。
#   每个文件包含该环境的完整配置。
#
# 使用方法:
#   1. 按环境创建配置文件:
#      cp .env.example.local .env.develop
#      cp .env.example.local .env.testing
#      cp .env.example.local .env.production
#
#   2. 编辑各环境配置文件
#
#   3. 运行时指定环境:
#      ./.cli.sh deploy -e .env.testing
#      ./.cli.sh deploy -e .env.production
#
# 注意: .env.* 文件应添加到 .gitignore，不要提交到版本控制
#===============================================================================

#===============================================================================
# Docker 镜像配置 (cli.sh 使用)
#===============================================================================

# 构建镜像 (Go: golang:1.24, Maven: maven:3.8.1-openjdk-11, Node: node:16.17)
# export IMAGE_BUILD="golang:1.24"

# 部署镜像
# export IMAGE_DEPLOY="i3est/debian:stable-20251229"

# 缓存卷名前缀 (Go: go-cache, Maven: maven-cache, Node: node-cache)
# export CACHE_VOLUME_PREFIX="go-cache"

# 缓存目录 (Go: .go, Maven: .m2, Node: node_modules)，设为空禁用缓存
# export CACHE_DIR=".go"

# 容器中项目目录
# export CONTAINER_PROJECT_DIR="/builds/project"


#===============================================================================
# 基础配置
#===============================================================================

# 环境名称 (develop | testing | staging | production)
export ENV_NAME="develop"

# 项目名称
export CI_PROJECT_NAME="my-service"

# 客户/组织标识 (用于 Vault 路径等)
export CUSTOMER="my-company"

# 版本标签 (可选，默认从 Git 获取)
# export CD_VERSION_TAG="1.0.0"

#===============================================================================
# SSH 配置
#===============================================================================

# SSH 用户名
export SSH_USER="deploy"

# SSH 主机地址
export SSH_HOST="192.168.1.10"

# SSH 私钥 (从文件读取)
export SSH_PRIVATE_KEY="$(cat ~/.ssh/id_rsa 2>/dev/null || echo '')"

# SSH Known Hosts (可选，不设置则自动获取)
# export SSH_KNOWN_HOSTS="192.168.1.10 ssh-rsa AAAA..."

#===============================================================================
# 跳板机配置 (可选 - 如果需要通过跳板机访问)
#===============================================================================

# 跳板机地址
# export JUMPER_SSH_HOST="bastion.example.com"

# 跳板机 Known Hosts
# export JUMPER_SSH_KNOWN_HOSTS="bastion.example.com ssh-rsa AAAA..."

#===============================================================================
# 上传配置 (可选 - 如果上传服务器与部署服务器不同)
#===============================================================================

# 上传用户 (默认使用 SSH_USER)
# export UPLOAD_SSH_USER="uploader"

# 上传私钥 (默认使用 SSH_PRIVATE_KEY)
# export UPLOAD_SSH_PRIVATE_KEY="$(cat ~/.ssh/id_rsa_upload)"

#===============================================================================
# 部署配置 (可选)
#===============================================================================

# 部署用户 (默认使用 SSH_USER)
# export DEPLOY_SSH_USER="deployer"

# 部署私钥 (默认使用 SSH_PRIVATE_KEY)
# export DEPLOY_SSH_PRIVATE_KEY="$(cat ~/.ssh/id_rsa_deploy)"

# 网卡名称 (用于获取服务器 IP)
# export DEPLOY_HOST_ETH="eth0"

#===============================================================================
# 目标服务器配置 (服务实际运行的服务器)
#===============================================================================

# 目标服务器用户 (默认使用 CUSTOMER)
# export SERVICE_SSH_USER="app"

# 目标服务器地址 (支持环境后缀: SERVICE_SSH_HOST_PRODUCTION)
# export SERVICE_SSH_HOST="10.0.0.100"

#===============================================================================
# 服务配置
#===============================================================================

# 服务组名称
# export SERVICE_GROUP="my-group"

# 服务名称 (默认使用 CI_PROJECT_NAME)
# export SERVICE_NAME="my-service"

# Home 目录基础路径 (Linux: /home, macOS: /Users)
# 当跳板机和部署机为相同操作系统时，只需设置此项即可
# export HOME_BASE_DIR="/home"

# 部署机 - 服务根目录 (优先级高于 HOME_BASE_DIR, 可指定任意路径)
# 当跳板机和部署机操作系统不同时，需分别指定以下两项
# export SERVICE_BASE_DIR="/opt/services"

# 跳板机 - 上传根目录 (优先级高于 HOME_BASE_DIR, 可指定任意路径)
# export UPLOAD_BASE_DIR="/data/upload"

# 容器工作目录 (默认使用 SERVICE_BASE_DIR)
# export CONTAINER_WORK_DIR="/home/deploy"

# 服务停止等待时间 (秒)
# export SERVICE_STOP_WAIT="8"


#===============================================================================
# Vault 配置 (可选 - HashiCorp Vault)
#===============================================================================

# 禁用 Vault (如果不使用 Vault)
export OPTION_VAULT_DISABLED="yes"

# 服务 Vault 配置
# export SERVICE_VAULT_URL="https://vault.example.com/v1"
# export SERVICE_VAULT_USER="ci-service"
# export SERVICE_VAULT_PASS="your-password"

# 项目 Vault 配置 (可选)
# export PROJECT_VAULT_URL="https://vault.example.com/v1"
# export PROJECT_VAULT_USER="ci-project"
# export PROJECT_VAULT_PASS="your-password"

# KV v2 引擎挂载点 (默认: secret)
# 全局设置，也可按角色/环境覆盖: SERVICE_VAULT_KV_MOUNT, PROJECT_VAULT_KV_MOUNT_PRODUCTION 等
# export VAULT_KV_MOUNT="secret"

#===============================================================================
# 选项开关
#===============================================================================

# 启用调试输出
# export OPTION_DEBUG="yes"

# 强制部署 (即使版本相同也部署)
# export OPTION_FORCE_DEPLOY="yes"

#===============================================================================
# Vault 路径配置 (可选 - 自定义 Vault 路径)
#===============================================================================

# 环境变量注入路径 (默认: {CI_PROJECT_NAME}/gitlab-env)
# export VAULT_PATH_ENV="my-service/gitlab-env"

# CI 脚本注入路径 (默认: {CI_PROJECT_NAME}/gitlab-ci)
# export VAULT_PATH_CI="my-service/gitlab-ci"

# CD 脚本注入路径 (默认: {CI_PROJECT_NAME}/gitlab-cd)
# export VAULT_PATH_CD="my-service/gitlab-cd"

#===============================================================================
# GitLab CI 变量 (本地测试时需要模拟)
#===============================================================================

# 项目目录 (本地测试时设置为当前目录)
# export CI_PROJECT_DIR="${PWD}"

# 项目名称
# export CI_PROJECT_NAME="my-service"

# 分支名称
# export CI_COMMIT_REF_NAME="develop"

# Git 标签 (可选)
# export CI_COMMIT_TAG=""

# 流水线 ID (本地测试用)
# export CI_PIPELINE_ID="1"
# export CI_PIPELINE_IID="1"

# 任务信息 (本地测试用)
# export CI_JOB_ID="1"
# export CI_JOB_NAME="local-test"
# export CI_JOB_STAGE="deploy"
