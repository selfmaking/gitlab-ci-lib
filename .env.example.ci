#!/usr/bin/env bash
#===============================================================================
# GitLab CI/CD Variables 配置参考
#
# 本文件列出在 GitLab CI/CD Settings > Variables 中需要配置的所有环境变量。
# 这些变量将由 GitLab Runner 在流水线运行时自动注入。
#
# 图例:
#   [必需]   - 必须配置，否则流水线会失败
#   [推荐]   - 强烈建议配置
#   [可选]   - 按需配置，有默认值或降级机制
#   [环境后缀] - 支持通过 _DEVELOP / _TESTING / _STAGING / _PRODUCTION 后缀
#              为不同环境设置不同值
#
# 环境后缀示例:
#   SSH_USER=deploy              ← 默认值
#   SSH_USER_TESTING=test-user   ← 测试环境覆盖
#   SSH_USER_PRODUCTION=ops      ← 生产环境覆盖
#
# 变量类型建议:
#   - 含敏感信息的变量 (私钥、密码等) 请勾选 "Mask variable" 和 "Protect variable"
#   - 多行内容的变量 (SSH 私钥、Known Hosts) 类型选 "File" 或直接粘贴内容
#===============================================================================


#===============================================================================
# 基础配置 [必需]
#===============================================================================

# 部署环境名称 (develop | testing | staging | production)
# 通常在每个 Job 中通过 variables 字段设置，而非全局配置
# ENV_NAME="develop"

# 客户/组织标识 (用于 Vault 路径、服务用户等)
CUSTOMER="my-company"


#===============================================================================
# SSH 基础配置 [必需] [环境后缀]
#
# 所有 SSH 角色 (上传/部署/服务) 默认降级到这组基础配置。
# 如果所有操作共用同一个 SSH 账号，只需配置这组即可。
#===============================================================================

# SSH 用户名
SSH_USER="deploy"

# SSH 主机地址
SSH_HOST="192.168.1.10"

# SSH 私钥内容 (建议设为 Protected + Masked)
# 类型: Variable (粘贴私钥全文，包含 BEGIN/END 行)
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"

# SSH Known Hosts 公钥 (可通过 ssh-keyscan 获取)
# 不设置时库会自动获取，但建议预先配置以防 MITM 攻击
SSH_KNOWN_HOSTS="192.168.1.10 ssh-rsa AAAA..."


#===============================================================================
# 跳板机配置 [可选] [环境后缀]
#
# 当目标服务器不可直接访问、需通过跳板机中转时配置。
# 降级顺序: JUMPER_SSH_HOST → SSH_HOST
#===============================================================================

# 跳板机主机地址
# JUMPER_SSH_HOST="bastion.example.com"

# 跳板机 Known Hosts
# JUMPER_SSH_KNOWN_HOSTS="bastion.example.com ssh-rsa AAAA..."


#===============================================================================
# 上传配置 [可选] [环境后缀]
#
# 构建产物上传到跳板机/中转服务器时使用。
# 降级顺序: UPLOAD_SSH_USER → SSH_USER
#           UPLOAD_SSH_PRIVATE_KEY → SSH_PRIVATE_KEY
#===============================================================================

# 上传用户 (默认使用 SSH_USER)
# UPLOAD_SSH_USER="uploader"

# 上传私钥 (默认使用 SSH_PRIVATE_KEY)
# UPLOAD_SSH_PRIVATE_KEY="..."


#===============================================================================
# 部署配置 [可选] [环境后缀]
#
# 部署阶段 SSH 到跳板机时使用 (从跳板机再跳到目标服务器)。
# 降级顺序: DEPLOY_SSH_USER → UPLOAD_SSH_USER → SSH_USER
#           DEPLOY_SSH_PRIVATE_KEY → UPLOAD_SSH_PRIVATE_KEY → SSH_PRIVATE_KEY
#===============================================================================

# 部署用户 (默认使用 UPLOAD_SSH_USER 或 SSH_USER)
# DEPLOY_SSH_USER="deployer"

# 部署私钥 (默认使用 UPLOAD_SSH_PRIVATE_KEY 或 SSH_PRIVATE_KEY)
# DEPLOY_SSH_PRIVATE_KEY="..."

# 部署目标服务器的网卡名称 (用于自动获取服务器 IP)
# DEPLOY_HOST_ETH="eth0"


#===============================================================================
# 目标服务器配置 [推荐] [环境后缀]
#
# 服务实际运行的目标服务器配置。
# 如果通过跳板机部署，这里是跳板机后面的实际服务器。
#===============================================================================

# 目标服务器上的服务运行用户 (默认使用 CUSTOMER 值)
# SERVICE_SSH_USER="app"

# 目标服务器地址
# SERVICE_SSH_HOST="10.0.0.100"


#===============================================================================
# 服务配置 [推荐]
#===============================================================================

# 服务组名称 (用于组织目录结构，如: backend, frontend, gateway)
# SERVICE_GROUP="my-group"

# 服务名称 (默认使用 CI_PROJECT_NAME)
# SERVICE_NAME="my-service"


#===============================================================================
# 目录配置 [可选]
#===============================================================================

# Home 目录基础路径 (Linux: /home, macOS: /Users)
# 当跳板机和部署机为相同操作系统时，只需设置此项
# HOME_BASE_DIR="/home"

# 部署机 - 服务根目录 (优先级高于 HOME_BASE_DIR)
# 当跳板机和部署机操作系统不同时，需分别指定
# SERVICE_BASE_DIR="/opt/services"

# 跳板机 - 上传根目录 (优先级高于 HOME_BASE_DIR)
# UPLOAD_BASE_DIR="/data/upload"

# 容器工作目录 (默认使用 SERVICE_BASE_DIR)
# CONTAINER_WORK_DIR="/home/deploy"

# 服务停止等待时间 (秒)
# SERVICE_STOP_WAIT="8"


#===============================================================================
# 版本配置 [可选]
#===============================================================================

# 版本标签 (通常从 CI_COMMIT_TAG 或分支名自动推导)
# CD_VERSION_TAG="1.0.0"


#===============================================================================
# Vault 配置 [可选] [环境后缀]
#
# HashiCorp Vault 集成，用于密钥/配置注入。
# 不使用 Vault 时设置 OPTION_VAULT_DISABLED=yes 即可。
#===============================================================================

# --- 服务级 Vault (用于部署时注入服务密钥/配置) ---

# Vault 服务地址
# SERVICE_VAULT_URL="https://vault.example.com/v1"

# Vault 用户名 (建议 Masked)
# SERVICE_VAULT_USER="ci-service"

# Vault 密码 (建议 Protected + Masked)
# SERVICE_VAULT_PASS="your-password"

# --- 项目级 Vault (用于 CI 阶段注入项目级配置) ---

# PROJECT_VAULT_URL="https://vault.example.com/v1"
# PROJECT_VAULT_USER="ci-project"
# PROJECT_VAULT_PASS="your-password"

# --- Vault 路径配置 ---

# KV v2 引擎挂载点 (默认: secret)
# 支持环境后缀和角色前缀: SERVICE_VAULT_KV_MOUNT, PROJECT_VAULT_KV_MOUNT_PRODUCTION 等
# VAULT_KV_MOUNT="secret"

# 环境变量注入路径 (默认: {CI_PROJECT_NAME}/gitlab-env)
# VAULT_PATH_ENV="my-service/gitlab-env"

# CI 脚本注入路径 (默认: {CI_PROJECT_NAME}/gitlab-ci)
# VAULT_PATH_CI="my-service/gitlab-ci"

# CD 脚本注入路径 (默认: {CI_PROJECT_NAME}/gitlab-cd)
# VAULT_PATH_CD="my-service/gitlab-cd"


#===============================================================================
# 选项开关 [可选]
#===============================================================================

# 禁用 Vault 集成
# OPTION_VAULT_DISABLED="yes"

# 启用调试输出 (输出详细的函数调用和变量信息)
# OPTION_DEBUG="yes"

# 强制部署 (即使版本相同也执行部署)
# OPTION_FORCE_DEPLOY="yes"


#===============================================================================
# 多环境配置示例
#
# 以下展示如何利用环境后缀为不同环境配置不同的值。
# 在 GitLab CI/CD Variables 页面中，每行配置为一个独立变量。
#===============================================================================
#
# --- 开发环境 ---
# SSH_HOST_DEVELOP="192.168.1.10"
# SERVICE_SSH_HOST_DEVELOP="10.0.1.10"
#
# --- 测试环境 ---
# SSH_HOST_TESTING="192.168.2.10"
# SSH_USER_TESTING="test-deploy"
# SERVICE_SSH_HOST_TESTING="10.0.2.10"
# DEPLOY_HOST_ETH_TESTING="ens192"
#
# --- 生产环境 ---
# SSH_HOST_PRODUCTION="10.0.0.1"
# SSH_USER_PRODUCTION="ops"
# SSH_PRIVATE_KEY_PRODUCTION="..."
# SERVICE_SSH_HOST_PRODUCTION="10.0.0.100"
# DEPLOY_HOST_ETH_PRODUCTION="bond0"
# SERVICE_VAULT_URL_PRODUCTION="https://vault-prod.example.com/v1"
# SERVICE_VAULT_USER_PRODUCTION="ci-prod"
# SERVICE_VAULT_PASS_PRODUCTION="..."